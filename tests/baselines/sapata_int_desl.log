>>> Modo Staged construction: Initial (K0) -> Footing -> Displacement
   CALL g_i.gotostages()
   SET g_i.InitialPhase.DeformCalcType = 'K0 procedure'
   CALL g_i.phase(<g_i.InitialPhase>,)
   SET g_i.phase().Identification = 'Footing'
   SET g_i.phase().Deform.ResetDisplacementsToZero = True
   CALL g_i.activate(<g_i.Plate_1>, <g_i.phase()>)
   CALL g_i.phase(<g_i.phase()>,)
   SET g_i.phase().Identification = 'Displacement'
   SET g_i.phase().Deform.ResetDisplacementsToZero = True
   CALL g_i.activate(<g_i.SurfaceDisplacement_1>, <g_i.phase()>)
   CALL g_i.phase().Deform.setproperties('UseDefaultIterationParams', False)
   CALL g_i.phase().Deform.setproperties('MaxLoadFractionPerStep', 0.02)
   CALL g_i.phase().Deform.echo()
