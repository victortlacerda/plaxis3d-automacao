   CALL g_i.phase(<g_i.phase()>,)
   SET g_i.phase().Identification = 'Construction'
>>> Fase Construction: ativa o piso, a coluna e as vigas
   CALL g_i.activate(<g_i.plate()>, <g_i.phase()>)
   CALL g_i.activate(<g_i.beam()>, <g_i.phase()>)
   CALL g_i.activate(<g_i.beam()>, <g_i.phase()>)
   CALL g_i.activate(<g_i.beam()>, <g_i.phase()>)
   CALL g_i.phase(<g_i.phase()>,)
   SET g_i.phase().Identification = 'Loading'
>>> Fase Loading: ativa as cargas
   CALL g_i.activate(<g_i.surfload()>, <g_i.phase()>)
